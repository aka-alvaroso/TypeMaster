{
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "start": "concurrently \"pnpm --filter Frontend dev\" \"pnpm --filter Backend start\" --names \"Frontend,Backend\" --prefix-colors \"bgBlue,bgGreen\"",
    "install:all": "pnpm install",
    "dev": "pnpm run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
